# ======================================================================
#  Deriv AI Rise & Fall Bot - configuration
#  Copy this file to `.env` and fill in your values:   cp .env.example .env
#  NEVER commit your real .env (it is already in .gitignore).
# ======================================================================

# ---- Deriv connection -------------------------------------------------
# API token: https://app.deriv.com/account/api-token  (scopes: Read + Trade)
# Use a token from your DEMO account first.
DERIV_API_TOKEN=your_deriv_api_token_here
# 1089 is Deriv's public test app_id. Register your own at https://api.deriv.com (optional).
DERIV_APP_ID=1089
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3

# ---- Contract ----------------------------------------------------------
# R_10, R_25, R_50, R_75, R_100, 1HZ10V, 1HZ25V, 1HZ50V, 1HZ75V, 1HZ100V ...
SYMBOL=R_75
STAKE=1.00
TICK_DURATION=5

# ---- Mode --------------------------------------------------------------
# true  = simulate trades on live prices, no orders sent (default, recommended)
# false = place REAL contracts on the account that owns DERIV_API_TOKEN
PAPER_TRADE=true
# Safety lock: live mode refuses to trade a real-money account unless this is true.
ALLOW_REAL_ACCOUNT=false
PAPER_START_BALANCE=1000

# ---- Profit target & risk ---------------------------------------------
PROFIT_TARGET=25
MAX_DAILY_LOSS=15
MAX_TRADES_PER_DAY=20
MAX_CONSECUTIVE_LOSSES=4
COOLDOWN_SECONDS=30

# ---- Machine learning --------------------------------------------------
TRAIN_WINDOW=100
MIN_ML_PROBABILITY=0.60

# ---- LLM filter (Groq) -------------------------------------------------
# Free key: https://console.groq.com/keys . Leave empty to run ML-only.
USE_LLM=true
GROQ_API_KEY=your_groq_api_key_here
# Any Groq chat model id works, e.g. openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b
MIN_AI_CONFIDENCE=78
REQUIRE_AGREEMENT=true
LLM_TIMEOUT=12
