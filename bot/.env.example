# ------------------------------------------------------------------
# Market Cycle Trader — Crash 500 EMA bot (Deriv)
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must NEVER be committed.
# ------------------------------------------------------------------

# Deriv app id. 1089 is Deriv's public test app id.
# For live trading, register your own app at https://developers.deriv.com
APP_ID=1089

# Deriv WebSocket endpoint
ENDPOINT=wss://ws.derivws.com/websockets/v3

# Market. CRASH500 = Deriv "Crash 500" synthetic index (buy only).
SYMBOL=CRASH500

# Candle timeframe in seconds (60 = 1-minute candles).
GRANULARITY=60

# Strategy: exponential moving averages. "If price starts trading above
# the 10,4 EMA it is bullish -> BUY." Fast period must be < slow period.
EMA_FAST=4
EMA_SLOW=10

# Take profit after this many completed 1-minute candles (default 5).
HOLD_BARS=5

# Execution contract type:
#   MULTUP = multiplier "buy market", closed manually at take profit (recommended)
#   CALL   = binary up contract that expires automatically after HOLD_BARS minutes
CONTRACT_TYPE=MULTUP

# Trade size / risk
STAKE=1
MULTIPLIER=100
CURRENCY=USD

# Contract duration used when buying MULTUP (closed early at take profit).
DURATION=1
DURATION_UNIT=d

# Number of historical candles used to warm up the EMAs.
SEED_CANDLES=60

# Local dashboard port.
PORT=3000

# Your Deriv API token (create one with Read + Trade scopes at
# https://app.deriv.com/account/api-token). Leave empty for dry-run.
API_TOKEN=

# Set to true ONLY when you are ready for real orders on a real/demo account.
# Without this, the bot runs in DRY-RUN (signals logged, no real orders).
LIVE_TRADING=false
